rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && getUserRole() in ['Admin', 'Super Admin'];
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'Super Admin';
    }
    
    function isTeacherOrAdmin() {
      return isSignedIn() && getUserRole() in ['Teacher', 'Admin', 'Super Admin'];
    }
    
    // Users Collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for displaying names, etc.)
      allow read: if isSignedIn();
      
      // Users can create their own profile
      allow create: if isSignedIn() && isOwner(userId);
      
      // Users can update their own profile, admins can update any
      allow update: if isOwner(userId) || isAdmin();
      
      // Only super admins can delete users
      allow delete: if isSuperAdmin();
      
      // User activity subcollection
      match /activities/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }
    
    // Lectures Collection
    match /lectures/{lectureId} {
      // Read rules based on visibility
      allow read: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        isOwner(resource.data.uploadedBy) ||
        isAdmin()
      );
      
      // Teachers and admins can create lectures
      allow create: if isTeacherOrAdmin() && 
        request.resource.data.uploadedBy == request.auth.uid;
      
      // Owners and admins can update
      allow update: if isSignedIn() && (
        isOwner(resource.data.uploadedBy) ||
        isAdmin()
      );
      
      // Owners and admins can delete
      allow delete: if isSignedIn() && (
        isOwner(resource.data.uploadedBy) ||
        isAdmin()
      );
      
      // Lecture comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && 
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );
      }
    }
    
    // Digests Collection
    match /digests/{digestId} {
      // Users can read their own digests, admins can read all
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      
      // Users can create their own digests
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can update/delete their own digests
      allow update, delete: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }
    
    // Transcripts Collection
    match /transcripts/{transcriptId} {
      // All authenticated users can read transcripts
      allow read: if isSignedIn();
      
      // Only system/admins can write transcripts
      allow write: if isAdmin();
    }
    
    // System Collections (admin only)
    match /system/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Analytics Collection (admin only)
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
