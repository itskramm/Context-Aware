PORT=3001
NODE_ENV=production

# Firebase Configuration
FIREBASE_PROJECT_ID=contextaware-507ad

# For local development - use file path:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# For Render deployment - paste entire JSON content:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"contextaware-507ad",...}

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://contextaware.vercel.app

# AI Services (100% FREE with Groq only!)
# Get your free Groq API key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# Models Used:
# - Transcription: whisper-large-v3 (Groq)
# - Summarization: openai/gpt-oss-120b (Groq)  
# - Questions: openai/gpt-oss-120b (Groq)
# Cost: $0.00 per lecture!
